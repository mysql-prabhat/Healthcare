<mxfile host="app.diagrams.net">
  <diagram name="Document Processing Flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10"
      guides="1" tooltips="1" connect="1"
      arrows="1" fold="1" page="1"
      pageScale="1" pageWidth="1800"
      pageHeight="1400">

      <root>

        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Upload -->

        <mxCell id="2"
          value="Upload Document&#10;(PDF / DOCX / TXT)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeWidth=2;"
          vertex="1"
          parent="1">
          <mxGeometry x="600" y="40" width="240" height="80" as="geometry"/>
        </mxCell>

        <!-- Validation -->

        <mxCell id="3"
          value="Validate Request&#10;JWT&#10;File Type&#10;Patient Association"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeWidth=2;"
          vertex="1"
          parent="1">
          <mxGeometry x="580" y="170" width="280" height="100" as="geometry"/>
        </mxCell>

        <!-- Store File -->

        <mxCell id="4"
          value="Store File&#10;uploads/"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;"
          vertex="1"
          parent="1">
          <mxGeometry x="620" y="320" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Audit -->

        <mxCell id="5"
          value="Audit Event&#10;DOCUMENT_UPLOADED"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;"
          vertex="1"
          parent="1">
          <mxGeometry x="930" y="320" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Status -->

        <mxCell id="6"
          value="Status = UPLOADED"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;"
          vertex="1"
          parent="1">
          <mxGeometry x="610" y="450" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Redis -->

        <mxCell id="7"
          value="Redis Queue&#10;document_queue"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;"
          vertex="1"
          parent="1">
          <mxGeometry x="610" y="580" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- Worker -->

        <mxCell id="8"
          value="Worker Service&#10;process_document()"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;"
          vertex="1"
          parent="1">
          <mxGeometry x="610" y="720" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- Extract Text -->

        <mxCell id="9"
          value="Extract Text&#10;PDF Parser&#10;DOCX Parser"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;"
          vertex="1"
          parent="1">
          <mxGeometry x="610" y="860" width="220" height="100" as="geometry"/>
        </mxCell>

        <!-- Patient Context -->

        <mxCell id="10"
          value="Get Patient Context&#10;Conditions&#10;Observations&#10;Medications"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;"
          vertex="1"
          parent="1">
          <mxGeometry x="930" y="860" width="260" height="100" as="geometry"/>
        </mxCell>

        <!-- Ollama -->

        <mxCell id="11"
          value="Ollama&#10;llama3.2"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;"
          vertex="1"
          parent="1">
          <mxGeometry x="610" y="1020" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Summary -->

        <mxCell id="12"
          value="Generate Clinical Summary"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;"
          vertex="1"
          parent="1">
          <mxGeometry x="610" y="1160" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Actions -->

        <mxCell id="13"
          value="Generate Recommended Actions&#10;Follow-up&#10;Order Labs&#10;Review Medication"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;"
          vertex="1"
          parent="1">
          <mxGeometry x="930" y="1160" width="260" height="100" as="geometry"/>
        </mxCell>

        <!-- Pending Review -->

        <mxCell id="14"
          value="Status = PENDING_REVIEW"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;"
          vertex="1"
          parent="1">
          <mxGeometry x="610" y="1300" width="240" height="80" as="geometry"/>
        </mxCell>

        <!-- Review Queue -->

        <mxCell id="15"
          value="Review Queue&#10;Human Approval Required"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;"
          vertex="1"
          parent="1">
          <mxGeometry x="1380" y="650" width="260" height="100" as="geometry"/>
        </mxCell>

        <!-- Approve -->

        <mxCell id="16"
          value="APPROVE"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;"
          vertex="1"
          parent="1">
          <mxGeometry x="1280" y="850" width="180" height="80" as="geometry"/>
        </mxCell>

        <!-- Reject -->

        <mxCell id="17"
          value="REJECT"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;"
          vertex="1"
          parent="1">
          <mxGeometry x="1540" y="850" width="180" height="80" as="geometry"/>
        </mxCell>

        <!-- Audit -->

        <mxCell id="18"
          value="Audit Logs&#10;APPROVED / REJECTED"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;"
          vertex="1"
          parent="1">
          <mxGeometry x="1380" y="1030" width="260" height="100" as="geometry"/>
        </mxCell>

        <!-- Retry -->

        <mxCell id="19"
          value="Retry Queue&#10;Retry #1&#10;Retry #2&#10;Retry #3"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;"
          vertex="1"
          parent="1">
          <mxGeometry x="280" y="1020" width="220" height="120" as="geometry"/>
        </mxCell>

        <!-- DLQ -->

        <mxCell id="20"
          value="Dead Letter Queue&#10;FAILED"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;"
          vertex="1"
          parent="1">
          <mxGeometry x="260" y="1220" width="250" height="90" as="geometry"/>
        </mxCell>

        <!-- Connections -->

        <mxCell id="e1" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" edge="1" parent="1" source="4" target="6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e5" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e6" edge="1" parent="1" source="7" target="8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e7" edge="1" parent="1" source="8" target="9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e8" edge="1" parent="1" source="9" target="11">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e9" edge="1" parent="1" source="10" target="11">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e10" edge="1" parent="1" source="11" target="12">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e11" edge="1" parent="1" source="12" target="14">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e12" edge="1" parent="1" source="13" target="14">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e13" edge="1" parent="1" source="14" target="15">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e14" edge="1" parent="1" source="15" target="16">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e15" edge="1" parent="1" source="15" target="17">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e16" edge="1" parent="1" source="16" target="18">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e17" edge="1" parent="1" source="17" target="18">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>